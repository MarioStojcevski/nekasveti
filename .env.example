# Supabase (public — safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only service role key (NEVER shipped to the browser). Used by the
# /api/bookings route to write bookings. If empty, the server falls back to the
# anon key above (works only if RLS allows anon inserts).
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard credentials — validated server-side via /api/admin/login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
